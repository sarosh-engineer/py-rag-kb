# Copy this file to .env and adjust it for local development.
# Never commit a real .env file. Do not put AWS keys, database passwords,
# or model credentials in this example.

# Application identity
APP_NAME=genai-rag-assistant
APP_ENV=local
APP_VERSION=0.1.0

# Logging. LOG_JSON=true writes one JSON object per line to stdout.
LOG_LEVEL=INFO
LOG_JSON=true

# Bind address used by the documented local run command.
# The container image overrides the host to 0.0.0.0.
HOST=127.0.0.1
PORT=8000

# Comma-separated browser origins. Leave empty to allow none.
# Wildcard "*" is rejected. Example:
# CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOWED_ORIGINS=

# Signing key for access tokens. Required in production and required before
# login works in any environment. Use at least 32 characters.
# Generate one locally; do not commit the generated value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional first administrator, created at startup when the email is absent.
# Leave both empty to disable. Public registration cannot create an admin.
# The password is read from the environment only and is not a default secret.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
