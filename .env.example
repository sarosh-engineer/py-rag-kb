# Copy this file to .env and adjust it for local development.
# Never commit a real .env file. Do not put AWS keys, database passwords,
# or model credentials in this example.

# Application identity
APP_NAME=genai-rag-assistant
APP_ENV=local
APP_VERSION=0.1.0

# Logging. LOG_JSON=true writes one JSON object per line to stdout.
LOG_LEVEL=INFO
LOG_JSON=true

# Bind address used by the documented local run command.
# The container image overrides the host to 0.0.0.0.
HOST=127.0.0.1
PORT=8000

# Comma-separated browser origins. Leave empty to allow none.
# Wildcard "*" is rejected. Example:
# CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOWED_ORIGINS=
